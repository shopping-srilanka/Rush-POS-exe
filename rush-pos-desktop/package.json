{
  "name": "rush-pos-pro",
  "productName": "Rush POS Pro",
  "version": "8.6.3",
  "description": "Rush POS Pro - desktop app (Chromium/Electron)",
  "main": "main.js",
  "author": "Rush Environment",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rush.pos.pro",
    "productName": "Rush POS Pro",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "app/**/*"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "perMachine": false }
  }
}
